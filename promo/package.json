{
  "name": "mochi-promo",
  "private": true,
  "description": "The Mochi Crew promo video, drawn with Remotion from the plugin's own pixel renderer.",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still MochiPromo out/still.png",
    "thumbnail": "remotion still Thumbnail out/thumbnail.png",
    "render": "remotion render MochiPromo out/mochi-promo.mp4",
    "typecheck": "tsc --noEmit",
    "voice": "node scripts/voice.mts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "@remotion/google-fonts": "4.0.530",
    "@remotion/media-utils": "4.0.530",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
